# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values before running the suite.
# .env is git-ignored; .env.example documents the required shape only.
# ---------------------------------------------------------------------------

# Base URL for UI tests (Playwright `baseURL`)
UI_BASE_URL=https://automationexercise.com

# Base URL for API tests. Same host here, kept separate on purpose so the
# framework can point UI and API at different environments (e.g. a staging
# API behind a different host) without touching test code.
API_BASE_URL=https://automationexercise.com/api

# Credentials for the "authenticated user" persona used by fixtures &
# auth.setup.js. The setup step will create this account via the public
# createAccount API if it does not already exist, then log in once via the
# UI to mint a real browser session (see auth.setup.js for why).
TEST_USER_NAME=QA Portfolio User
TEST_USER_EMAIL=qa.portfolio.user@example.com
TEST_USER_PASSWORD=Str0ngP@ssw0rd!

# A second, throwaway persona used by tests that intentionally exercise the
# signup flow end-to-end (so they don't collide with TEST_USER_EMAIL).
# Leave blank to let utils/dataGenerator.js generate a unique one per run.
NEW_USER_EMAIL=

# Number of workers for local runs. Leave unset to let Playwright decide.
# WORKERS=4

# Set to "true" on CI runners (also auto-detected via process.env.CI)
CI=false
